# ─── Rantera Model Platform — Environment Configuration ──
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Application environment: development | staging | production
RANTERA_ENV=development

# Server bind address and port (local development).
APP_HOST=127.0.0.1
APP_PORT=8000

# ─── Database Configuration ──────────────────────────────
# Async PostgreSQL connection string (local development only).
# In production, inject via Google Cloud Secret Manager.
# DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@127.0.0.1:5432/<db-name>

# ─── Google Cloud Platform ────────────────────────────────
# GCP project that hosts the Vertex AI endpoint(s).
GCP_PROJECT_ID=<pending-project-id>
GCP_REGION=<pending-region>

# ─── Vertex AI ────────────────────────────────────────────
# Endpoint ID for the rantera-base-v1 model.
VERTEX_ENDPOINT_ID=<pending-endpoint-id>

# ─── API Key Management (Planned) ──────────────────────────
# Persistent key storage and hashing algorithm configuration are deferred
# to the authentication phase. Hashing is currently not runtime-configurable.

# ─── Internal Service Authentication ──────────────────────
# Pre-shared secret for trusted server-to-server calls from website to gateway.
# Generate with: openssl rand -hex 32
# In production, inject via Google Cloud Secret Manager.
INTERNAL_SERVICE_KEY=<pending-internal-service-key>

# ─── Durable Telemetry & Pub/Sub ─────────────────────────
# Fail closed (HTTP 503) if telemetry cannot be durably committed in production.
TELEMETRY_FAIL_CLOSED=true
# Enable durable queue publication for telemetry events.
TELEMETRY_QUEUE_ENABLED=false
# Pub/Sub topic name for inference telemetry.
PUBSUB_TOPIC_TELEMETRY=mp-inference-telemetry
# Pub/Sub dead-letter topic name for corrupted/poison telemetry events.
PUBSUB_DEAD_LETTER_TOPIC=mp-inference-telemetry-dlq

# ─── Pub/Sub Push Webhook Authentication (Google OIDC) ────
# Required when using Pub/Sub push delivery mode with OIDC tokens.
# Expected audience (e.g., https://gateway.rantera.com/v1/telemetry/pubsub/push)
PUBSUB_PUSH_AUDIENCE=
# Authorized service account email for Pub/Sub push delivery
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=

# ─── Rate Limiting ───────────────────────────────────────
# Maximum requests per minute per API key.
RATE_LIMIT_RPM=60

# ─── Model Identity & Chat Template (HIRA) ───────────────
# Enforce canonical HIRA system prompt at gateway (default: true).
HIRA_SYSTEM_PROMPT_ENABLED=true
# Optional custom override for HIRA system prompt (empty uses default canonical prompt).
HIRA_SYSTEM_PROMPT=
# vLLM chat template enable_thinking mode parameter (default: false suppresses thinking tokens).
ENABLE_THINKING_DEFAULT=false

# ─── Logging ─────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
